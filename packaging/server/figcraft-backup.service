# Nightly backup of figcraft-server's data directory (an example; docs/server.md, "Backups").
# install.sh installs it with figcraft-backup.timer; turn it on with
#   sudo systemctl enable --now figcraft-backup.timer
# It stops the server for the few seconds the copy takes (apps reconnect on their own), writes
# /var/backups/figcraft-server/figcraft-YYYY-MM-DD.tar.gz and keeps the last 14 days. Copy that
# folder off the machine too (rsync, your provider's snapshots, object storage).

[Unit]
Description=Back up figcraft-server's data directory
After=figcraft-server.service

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
# `$$` and `%%` are a literal `$` and `%` for the shell (systemd expands the single ones).
ExecStart=/bin/sh -ec 'dir=/var/backups/figcraft-server; install -d -m 700 "$$dir"; systemctl stop figcraft-server; trap "systemctl start figcraft-server" EXIT; tar -C /var/lib -czf "$$dir/figcraft-$$(date +%%F).tar.gz" figcraft-server; find "$$dir" -name "figcraft-*.tar.gz" -mtime +14 -delete'
